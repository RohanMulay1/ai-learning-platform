ELEVENLABS_API_KEY=...        # Optional: for TTS voice tutor

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1

# Debug
DEBUG=false
